{
  "$comment": "The tag vocabulary. Single source of truth for profile fields and scholarship rule fields. Paths mirror the avatar emitted by questionnaire/avatar.js. `[]` marks a repeatable group; a rule on `a[].b` passes if ANY element matches. role=eligibility fields can appear in rules; role=preference fields (effort, exclusions) are handled by the match engine's database filter. source=derived fields are computed server-side and never asked. withheld_key is the id suffix the frontend writes into the section's `withheld` array when the user picks 'prefer not to answer'.",
  "version": 1,
  "ops": {
    "eq": "field equals value",
    "in": "field is one of value[]",
    "not_in": "field is none of value[]",
    "gte": "number >= value",
    "lte": "number <= value",
    "between": "value = [min, max] inclusive",
    "contains_any": "list field shares at least one item with value[]",
    "contains_all": "list field includes every item of value[]",
    "prefix_any": "some list item starts with any prefix in value[] (CIP codes)",
    "present": "field has any value (value omitted)",
    "is_true": "bool field is true (value omitted)",
    "is_false": "bool field is false (value omitted)"
  },
  "ops_by_type": {
    "enum": [
      "eq",
      "in",
      "not_in",
      "present"
    ],
    "enum_list": [
      "contains_any",
      "contains_all",
      "present"
    ],
    "string": [
      "eq",
      "in",
      "not_in",
      "present"
    ],
    "string_list": [
      "contains_any",
      "contains_all",
      "prefix_any",
      "present"
    ],
    "number": [
      "gte",
      "lte",
      "between",
      "eq",
      "present"
    ],
    "bool": [
      "is_true",
      "is_false",
      "present"
    ]
  },
